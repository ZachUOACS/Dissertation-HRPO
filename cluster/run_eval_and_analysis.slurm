#!/bin/bash
# ======== SLURM Job Configuration ========
#SBATCH --job-name=hrpo-eval-analysis
#SBATCH --time=36:00:00
#SBATCH --open-mode=append
#SBATCH --output=slurm_logs/hrpo-eval-analysis-%j.log
#SBATCH --error=slurm_logs/hrpo-eval-analysis-%j.err
#SBATCH --gres=gpu:1

# Post-training pipeline (run AFTER all ablation jobs finish):
#   1. eval_all.py            — full 1319-question GSM8K eval of every final
#                               checkpoint + base models; comparison table
#   2. analyse_gate.py        — static plots (2-6, gradient flow) for all
#                               sizes, then dynamic plots (1/7/8, variance)
#                               per size
#   3. analyse_failures.py    — v4-vs-v1 (and v6-vs-v1) failure analysis per size
#   4. hrpo_overhead.py       — size x variant overhead matrix
#   5. generate_report.py     — LaTeX tables, summary figures, key findings

# ======== Environment Setup ========
export HOME=/data/ztay632/
export TMPDIR=/data/ztay632/
export HF_HOME=/data/ztay632/.cache/huggingface
export https_proxy=http://squid.auckland.ac.nz:3128
export http_proxy=http://squid.auckland.ac.nz:3128
export TORCHDYNAMO_DISABLE=1
# (No training happens here; wandb is untouched. Analyses read local JSON.)

# ======== Job Execution Steps ========
mkdir -p "$HF_HOME"
cd /data/ztay632/Dissertation-HRPO
source .venv/bin/activate

# Which setting the *diagnostic* stages (gate behaviour, failure modes) report.
# The study is reported at the corrected rp=1.0 setting, so these read the "-rp1"
# checkpoints and their figures overwrite the identically-named main-cell ones.
# Set ANALYSIS_SUFFIX="" to fall back to the original rp=1.2 main cells.
# (eval_all and analyse_replicates always process EVERY run regardless.)
# Exported so generate_report.py's static-gate fallback can match this setting
# (it must not regenerate the Λ figures at the rp=1.2 default and clobber them).
export ANALYSIS_SUFFIX="${ANALYSIS_SUFFIX:--rp1}"
echo "Diagnostic stages target ANALYSIS_SUFFIX='${ANALYSIS_SUFFIX}' checkpoints"

# Scope the whole report to a subset of model sizes. Default is 1.5b only: the
# 3B chain has not been rerun at rp=1.0, so including it would surface stale
# rp=1.2 3B rows/plots. Set HRPO_SIZES="1.5b 3b" once tier 7 (3B @ rp=1.0) lands.
# Exported so eval_all/analyse_gate/generate_report pick it up via their SIZES.
export HRPO_SIZES="${HRPO_SIZES:-1.5b}"
echo "Reporting sizes: HRPO_SIZES='${HRPO_SIZES}'"

# The gate/failure JSONs are MERGED across runs, so a previous 3B (rp=1.2) entry
# would linger even though this run is 1.5b-only. Clear them so they rebuild
# containing exactly the scoped sizes. (comparison_table + replicate_analysis are
# rebuilt wholesale by their stages, so they need no clearing.)
rm -f results/gate_analysis.json results/failure_analysis.json

# ---- Preflight: fail in seconds, not after burning GPU hours --------------
# matplotlib is NOT in requirements_train.txt (training never plots), so a
# fresh cluster venv is missing it and every plotting stage would die.
python - <<'PY' || { echo "Install with: pip install -r requirements_analysis.txt"; exit 1; }
import importlib, sys
missing = [m for m in ("matplotlib", "scipy", "sklearn", "numpy", "safetensors")
           if not importlib.util.find_spec(m)]
if missing:
    sys.exit(f"PREFLIGHT FAILED — missing packages: {', '.join(missing)}")
print("preflight OK: analysis dependencies present")
PY

set -x

# 1. Evaluations (skips anything already fully evaluated; a model that fails
#    to load is reported and skipped rather than aborting the whole stage).
#    Scoped to $HRPO_SIZES (default 1.5b) so the comparison table stays 1.5b-only.
python eval_all.py --batch_size 32 --sizes $HRPO_SIZES

# 1b. Start the figures fresh. Every PNG under results/plots/ is regenerated by
#     the stages below at the reported (ANALYSIS_SUFFIX) setting, so wiping here
#     guarantees no figure from an earlier run — e.g. a confounded rp=1.2 one —
#     can survive as a stale file for a cell that isn't rerun. Nothing here is
#     hand-made; all of it is reproducible from checkpoints + JSON.
rm -f results/plots/*.png
echo "cleared results/plots/*.png — regenerating at ANALYSIS_SUFFIX='${ANALYSIS_SUFFIX}'"

# 2. Gate behaviour analysis (on the ANALYSIS_SUFFIX checkpoints; figures
#    overwrite the identically-named main-cell ones).
#    NB: the value is passed with `=` (--variant_suffix=-rp1). Argparse otherwise
#    reads the leading '-' of "-rp1" as the start of another flag and aborts with
#    "expected one argument", silently skipping the whole gate analysis.
python analyse_gate.py --static --sizes $HRPO_SIZES --variant_suffix="$ANALYSIS_SUFFIX"
for SIZE in $HRPO_SIZES; do
    python analyse_gate.py --dynamic --model_size "$SIZE" --n_examples 200 \
        --batch_size 16 --variant_suffix="$ANALYSIS_SUFFIX" \
        || echo "dynamic gate analysis skipped/failed for $SIZE"
done

# 3. Failure-mode analysis (every size with both v4/v6 and v1 evaluated at the
#    reported setting). ${SIZE}-${VAR}${ANALYSIS_SUFFIX} resolves to the -rp1
#    dirs; analyse_failures strips the suffix so its figures overwrite cleanly.
for SIZE in $HRPO_SIZES; do
    for VAR in v4_full_hrpo_gate v6_hrpo_full; do
        HRPO_CKPT=$(ls -d experiments/${SIZE}-${VAR}${ANALYSIS_SUFFIX}/checkpoint-* 2>/dev/null | sort -V | tail -1)
        GRPO_CKPT=$(ls -d experiments/${SIZE}-v1_grpo_baseline${ANALYSIS_SUFFIX}/checkpoint-* 2>/dev/null | sort -V | tail -1)
        if [[ -n "$HRPO_CKPT" && -n "$GRPO_CKPT" ]]; then
            python analyse_failures.py "$HRPO_CKPT" "$GRPO_CKPT" \
                || echo "failure analysis skipped for ${SIZE}-${VAR}${ANALYSIS_SUFFIX}"
        else
            echo "failure analysis: no ${SIZE}-${VAR}${ANALYSIS_SUFFIX} / v1 pair yet, skipping"
        fi
    done
done

# 4. Overhead matrix (isolated subprocess timing per size x variant).
python hrpo_overhead.py --variant_matrix --matrix_sizes $HRPO_SIZES

# 4b. Seed-replicate & factor-aware summary (groups the follow-up runs into
#     arms, per-seed paired McNemar, mean±range figure). No GPU.
python analyse_replicates.py

# 5. Report.
python generate_report.py

echo "=== $(date -Is) pipeline complete — see results/ ==="
